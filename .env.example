# ---- Required ----

# From @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Supabase -> Project Settings -> Database -> Connection string -> URI
# IMPORTANT: use the "Session pooler" entry. The direct host (db.<ref>.supabase.co)
# is IPv6-only and will fail on App Platform and most home connections.
# Looks like: postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---- Leave these two as-is on the FIRST RUN ----
# The bot recognises these placeholder values and starts in SETUP MODE.
# DM it /id to get your user id, and forward a post from your vault channel
# to it to get the channel id. Paste both here, then restart.

# The private channel where you upload your marketing videos. Bot must be ADMIN there.
VAULT_CHAT_ID=-1001234567890

# Your Telegram numeric user id. Space or comma separated for multiple admins.
ADMIN_IDS=123456789

# ---- Optional ----

# Hours between broadcast cycles. Changeable at runtime with /interval
INTERVAL_HOURS=4

# Seconds to wait between each group. Keep >= 1.5 to stay clear of Telegram throttling.
DELAY_BETWEEN_GROUPS=2.0

# Appended to every caption (marketing CTA / link). Blank = copy captions untouched.
CAPTION_SUFFIX=
