# ---- Required ----

# From @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ---- Leave these two as-is on the first run ----
# The bot recognises these placeholder values and starts in SETUP MODE.
# DM it /id to get your user id, and forward a post from your vault channel
# to it to get the channel id. Paste both here, then restart.

# The private channel where you upload your marketing videos.
# Bot must be an ADMIN there. Looks like -1001234567890
VAULT_CHAT_ID=-1001234567890

# Your Telegram numeric user id. Space or comma separated for multiple admins.
ADMIN_IDS=123456789

# ---- Optional ----

# How often a broadcast cycle runs, in hours. Changeable at runtime with /interval
INTERVAL_HOURS=4

# Seconds to wait between each group. Keep >= 1.5 to stay clear of Telegram throttling.
DELAY_BETWEEN_GROUPS=2.0

# Appended to every video caption (marketing CTA / link). Leave blank to keep original captions untouched.
CAPTION_SUFFIX=

# SQLite file location
DB_PATH=data/broadcaster.db
